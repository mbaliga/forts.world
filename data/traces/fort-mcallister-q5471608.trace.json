n":null},"src":"osm:node/9709342297","ev":"mapped","conf":0.9,"id":"marker-2"},{"kind":"marker","at":[10.13,7.75],"name":"Tom Cat / Garrison Mascot","osmTags":{"historic":"memorial","inscription":"Please see photo https://www.mapillary.com/app/?pKey=4841308419332207&focus=photo&lat=31.8911706&lng=-81.196002699999&z=17","religion":null},"src":"osm:node/9709342298","ev":"mapped","conf":0.9,"id":"marker-3"},{"kind":"marker","at":[13.6,46.42],"name":"Cheves' Rice Mill","osmTags":{"historic":"memorial","inscription":"From the roof of Cheves' rice mill (2-1/2 miles across the Ogeechee in the direction of the arrow) General Sherman and his staff watched the reduction of Fort McAllister, sunset, December 13, 1864.","religion":null},"src":"osm:node/9709342299","ev":"mapped","conf":0.9,"id":"marker-4"},{"kind":"marker","at":[8.61,52.46],"name":"Damage from Naval Bombardments","osmTags":{"historic":"memorial","inscription":"Please see photo https://www.mapillary.com/app/?pKey=448589153701532&focus=photo&lat=31.8915772&lng=-81.196016099998&z=17","religion":null},"src":"osm:node/9709342300","ev":"mapped","conf":0.9,"id":"marker-5"},{"kind":"marker","at":[20.64,47.59],"name":"Obstruction of River","osmTags":{"historic":"memorial","inscription":"To block the channel of the Ogeechee River, a double row of piling was placed across the river at a point opposite this marker.","religion":null},"src":"osm:node/9709342301","ev":"mapped","conf":0.9,"id":"marker-6"},{"kind":"marker","at":[26.42,49.26],"name":"Position of the Monitors","osmTags":{"historic":"memorial","inscription":"The monitors took positions againsts the far marsh in the direction of the arrow, between 900 and 1200 yards from the fort during the following series of attacks by the MONTAUK, January 27, February 1, and February 28, 1863, and by the PASSAIC, the NAHANT","religion":null},"src":"osm:node/9709342302","ev":"mapped","conf":0.9,"id":"marker-7"},{"kind":"marker","at":[64.07,35.95],"name":"Major Gallie's Gun","osmTag